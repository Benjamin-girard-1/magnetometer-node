	(text "Filter 3: Shunt high-frequency differential \nnoise before the THS4551 summing stage\nfc = 1 / (2*pi*(5k + 5k)*1nF) ≈ 64 kHz"
		(exclude_from_sim no)
		(at 187.96 97.282 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "05b1ef71-1f57-4b11-87cd-232b6143f626")
	)
	(text "Filter 4: Anti-Aliasing with ADC at 1kSPS\nfc = 1 / (2*pi*(1k + 1k)*220nF) ≈ 362 Hz"
		(exclude_from_sim no)
		(at 287.274 65.532 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "306560a2-4e6f-4a80-8ce7-e30fb287905f")
	)
	(text "Filter 2: prevent DAC noise and step \nfc = 1 / (2*pi*10k*1uF) ≈ 15.9 Hz"
		(exclude_from_sim no)
		(at 158.496 57.658 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "52d5685b-e4ac-4781-8689-96988b8ae57b")
	)
	(text "V_{OUT}+ - V_{OUT}- = V_{IN}+ - V_{IN}- + 0.1 * (1.65 V - V_{DAC})\n"
		(exclude_from_sim no)
		(at 135.636 -57.404 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "7ae27525-e65c-4655-ac83-5631e55bc688")
	)
	(text "Bridge DC offset: -60mV to +30mV\nINA Gain = 61\nOffset after INA: -60mV * 61 to +30mV * 61 = 3.66V to 1.83V\nFrom the sensors measured the heighest was -15mV \n\nIf INA gain = 51 then \noffset: -60mV * 51 to +30mV * 51 = 3.06V to 1.53V\n\nTotal gain needed: 125\nG1 = 125/51 = 2.45\n\nIf we keep RF = 20k\nR_{in} = RF/G1 = 20k/2.45 = 8k2\n\nIf I use 2x 3.9k then I get G1 = 2.56\ntotal gain: 51 * 2.56 = 130.56\nWith 8x from the ADC PGA: 130.56 * 8 = 1044.48\n\nIf we keep G1 = 2 then: 51*2*8 = 816"
		(exclude_from_sim no)
		(at 59.944 44.196 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "7ce2819f-9bce-4d00-9a60-f1eb965bc73a")
	)
	(text "DAC B for Bridge offset compensation"
		(exclude_from_sim no)
		(at 70.866 156.21 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "865d976d-2000-46bd-a521-3604b1c3a961")
	)
	(text "V_{OUT}+ - V_{OUT}- = G_{1} * (V_{IN}+ - V_{IN}- ) + G_{2} * (V_{DAC B} - V_{DAC A})\n\nV_{DAC} goes from 0 to 3.3V\n\nG_{1} = RF / R_{in}\nG_{2} = RF / (R_{DAC}1 + R_{DAC}2)\n\nG_{1} = 20k / (5k + 5k) = 2\nG_{2} = 20k / (10k + 10k) = 1"
		(exclude_from_sim no)
		(at 147.066 34.798 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "874b3763-df74-4556-849c-1916874f052d")
	)
