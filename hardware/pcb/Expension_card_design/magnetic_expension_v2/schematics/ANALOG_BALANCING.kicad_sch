	(text "Filter 2: Prevent the integrator to \nsee too much the low frequency signals\nfc = 1 / (2*pi*300k*47uF) ≈ 11.3 mHz"
		(exclude_from_sim no)
		(at 227.33 136.144 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0612b4a8-6680-48da-9728-db5a690b233a")
	)
	(text "Filter 1: attenuate RF and high-frequency \ndifferential noise before the INA851 using \nthe Thenevin resistance of the bridge\nfc = 1 / (2*pi*(425 + 425)*10nF) ≈ 18.7 kHz"
		(exclude_from_sim no)
		(at 92.71 142.494 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0b452d34-f5ba-424b-a354-782db963ef85")
	)
	(text "Integrator: balance the brdige"
		(exclude_from_sim no)
		(at 283.718 153.924 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1b491147-01cd-4442-a17f-818b5bbc770f")
	)
	(text "Buffer the signal and apply the ADC bias \n(+1.65V)"
		(exclude_from_sim no)
		(at 228.6 198.12 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2d895ffa-d253-423f-ae89-5d4091100bb5")
	)
	(text "Vb/2 + V_{offset} + V_{Signal}"
		(exclude_from_sim no)
		(at 51.816 121.92 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "2d97efbd-d6a2-4346-9f3c-7b5d579464c0")
	)
	(text "Vb/2 + V_{offset} - V_{Signal}"
		(exclude_from_sim no)
		(at 51.816 138.43 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "69f74d0e-bb75-408a-94a2-dadca3342e52")
	)
	(text "Bridge offset trim sizing:\n\nPlan for:\nV_{offset_plan} = V_{offset_bridge_max} + V_{mag_static}\n           ≈ 60mV + 20mV\n           ≈ 80mV\n \n1) INA gain must not saturate before trim:\nG_{INA} <= V_{out_swing} / V_{offset_plan}\n      ≈ 4.5V / 80mV\n      ≈ 56\n\nChosen G_{INA} ≈ 51\n\n2) Injection must cover the same offset:\nV_{diff_corr_max} ≈ V_{drive_diff_max} * R_{th} / R_{inj}\n\nR_{inj} <= R_{th} * V_{drive_diff_max} / V_{offset_plan}\n        ≈ 425R * 9V / 80mV\n        ≈ 48k\n\nUse ≈40k for margin:\nV_{diff_corr_max} ≈ 9V * 425R / 40k\n                  ≈ 96mV"
		(exclude_from_sim no)
		(at 39.116 64.516 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a17d87b9-ef80-4ef9-9bcd-03bad8dc3c44")
	)
	(text "Inverter: to generate a symmetric \nsignal to the bridge"
		(exclude_from_sim no)
		(at 330.2 150.876 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c55ae6a2-1e1d-4531-9a53-05804ca70f14")
	)
	(text "INA851: apply gain of 51x G=1+6000/R_{G} \n"
		(exclude_from_sim no)
		(at 176.784 156.21 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "db359c07-9a52-4e1e-ae68-771e70f52e98")
	)
	(text "Filter 2: Anti-Aliasing Filter (AAF)\nfc = 1 / (2*pi*(1k + 1k)*220nF) ≈ 362 Hz"
		(exclude_from_sim no)
		(at 283.21 192.786 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e43f8e6b-0d8b-48d6-b5fe-6fdbbd71c8d0")
	)
